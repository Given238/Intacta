# Intacta Server — Environment Variables Template
# Copy to .env and fill in the values.
# NEVER commit .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=intacta
DB_USER=postgres
DB_PASSWORD=yourpassword

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# ── CORS / Socket.IO ──────────────────────────────────────────────────────────
# Set to your deployed frontend URL (e.g. https://yourapp.vercel.app)
CLIENT_ORIGIN=http://localhost:5173
# Set to this server's public URL (e.g. https://api.yourdomain.id)
API_ORIGIN=http://localhost:3000

# ── AI / Voice ────────────────────────────────────────────────────────────────
# Gemini (LLM responses, guardrails)
GEMINI_API_KEY=your-gemini-api-key
# ElevenLabs (server-side TTS, Phase 5)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Gemini model for replies (and STT / safety unless overridden)
GEMINI_MODEL=gemini-3.5-flash-lite
# Content-safety classifier (Tier 2); defaults to GEMINI_MODEL
GEMINI_SAFETY_MODEL=
# First reply attempt budget in ms (the short retry adds up to 2000 ms); default 2500
LLM_TIMEOUT_MS=2500

# ── Tests ─────────────────────────────────────────────────────────────────────
# 1 = also run the live-model tests (spends Gemini credits): RUN_LIVE_LLM_TESTS=1 npm test
RUN_LIVE_LLM_TESTS=0
